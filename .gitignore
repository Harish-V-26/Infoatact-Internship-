# ============================================
# CRITICAL: Private Keys — NEVER commit these
# ============================================
*.pem
*.key
private_key*
*.p12
*.pfx
*.pkcs12

# Allow public keys that are safe to commit
!crypto/public_key.pem
!crypto/ecdsa_public.pem

# Ignore private key directory
keys/

# Signature files (auto-generated)
*.sig
*.sig.json

# Test files
test_engine.py

# Generated files
firmware.hash
firmware.sig
*.sig
*.hash

# Python
__pycache__/
*.pyc
*.pyo
.env
.env.*
venv/
.venv/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Build artifacts
firmware.bin
dist/
build/

# Uploads and logs
server/uploads/*
edge-agent/logs/*
edge-agent/downloads/*
edge-agent/state.json

# Keep folder structure
!server/uploads/.gitkeep
!edge-agent/logs/.gitkeep
!edge-agent/downloads/.gitkeep
