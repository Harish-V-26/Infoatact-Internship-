# Path where the file should be created
file_path = "edge-agent/dummy_firmware.bin"

# The specific string required by your task
content = "FIRMWARE VERSION-1.0.0"

# Writing to the file in 'wb' (write binary) mode
with open(file_path, "wb") as f:
    f.write(content.encode("utf-8"))

print(f"File created successfully at: {file_path}")
