# Copy this to .env and fill in real values locally. Never commit .env.

# Set to "anthropic" (cloud, needs LLM_API_KEY) or "ollama" (free, local,
# no API key - runs entirely on your machine, so notes never leave it)
LLM_PROVIDER=ollama

# --- Anthropic (only used if LLM_PROVIDER=anthropic) ---
LLM_API_KEY=
LLM_API_URL=https://api.anthropic.com/v1/messages
LLM_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# --- Ollama (only used if LLM_PROVIDER=ollama) ---
# Install from ollama.com, then: ollama pull llama3.2
OLLAMA_API_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2

REDIS_HOST=localhost
REDIS_PORT=6379

LOG_LEVEL=INFO
